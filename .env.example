# 필요한 env 키 목록 (값은 비움). 실제 값은 .env.local(커밋 금지) 또는 Vercel Env.
# KASI (한국천문연구원) — data.go.kr. 서비스별 활용신청 필요 (CLAUDE.md §3).

# data.go.kr 일반 인증키(Decoding). 서버 사이드에서만 사용(§6.1).
KASI_SERVICE_KEY=

# 엔드포인트 (서비스별)
KASI_SPCDE_BASE=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
KASI_LRSR_BASE=https://apis.data.go.kr/B090041/openapi/service/LrsrCldInfoService

# Airtable (장소·유저·K-star 데이터). 서버 사이드에서만 (§6.1).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_PLACES=places
AIRTABLE_TABLE_KSTARS=kstars

# TourAPI (한국관광공사 B551011) — KASI와 별도 키. 서비스별 활용신청 (§3).
TOURAPI_SERVICE_KEY=
TOURAPI_WELLNESS_BASE=https://apis.data.go.kr/B551011/WellnessTursmService
TOURAPI_KOR_BASE=https://apis.data.go.kr/B551011/KorService2
TOURAPI_ENG_BASE=https://apis.data.go.kr/B551011/EngService2
TOURAPI_DURUNUBI_BASE=https://apis.data.go.kr/B551011/Durunubi

# 심사 기간 실시간 모드 (CLAUDE.md §6.5) — true면 배치성도 캐시 우회 실시간 호출
REALTIME_API_MODE=false

# 주기적 API 호출 크론 보호 (Vercel Cron이 Authorization: Bearer 로 전송). 임의 문자열.
CRON_SECRET=

# YouTube Data API v3 — PDP 여행자 영상 검색 (console.cloud.google.com에서 발급, 무료)
YOUTUBE_API_KEY=
